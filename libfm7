#!/bin/bash

SDK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMD="$1"
shift

if [ "$CMD" = "init" ]; then
    echo "Initializing libfm7 project..."
    cp "$SDK_ROOT/scripts/Makefile.template" "Makefile"
    mkdir -p src
    cp "$SDK_ROOT/scripts/main.c.template" "src/main.c"
    echo "Done."
    exit 0
fi

if [ "$CMD" = "make" ]; then
    echo "Running make inside libfm7-toolchain..."
    docker run --rm -v "$SDK_ROOT:/opt/libfm7" -v "$(pwd):/app" -w /app libfm7-toolchain make "$@"
    exit $?
fi

echo "Usage: libfm7 [init | make]"
exit 1

